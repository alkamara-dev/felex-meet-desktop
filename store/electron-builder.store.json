{
  "appId": "com.felexuss.meet",
  "productName": "FELEX Meet",
  "copyright": "FELEX Universal Services LLC",
  "directories": { "output": "release-store", "buildResources": "build" },
  "files": ["src/**/*", "package.json"],
  "publish": null,
  "win": {
    "target": [{ "target": "appx", "arch": ["x64"] }],
    "icon": "build/icon.png",
    "artifactName": "FELEX-Meet-Store.${ext}"
  },
  "appx": {
    "identityName": "${env.STORE_IDENTITY_NAME}",
    "publisher": "${env.STORE_PUBLISHER}",
    "publisherDisplayName": "${env.STORE_PUBLISHER_DISPLAY_NAME}",
    "applicationId": "FELEXMeet",
    "displayName": "FELEX Meet",
    "languages": ["en-US"],
    "backgroundColor": "#020617",
    "showNameOnTiles": false
  }
}
